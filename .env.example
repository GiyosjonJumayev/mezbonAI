# Copy to .env (never committed). For local use, `npm run db:local` adds the two database lines by itself.

# --- Database ---------------------------------------------------------------
# The server's restricted account, and the owner account that runs migrations
# DATABASE_URL=postgres://silkroad_app:…@127.0.0.1:5432/silkroad
# MIGRATE_URL=postgres://silkroad_owner:…@127.0.0.1:5432/silkroad
# DATABASE_SSL=1

# --- Production -------------------------------------------------------------
# NODE_ENV=production
# The address visitors use. HTTPS is required in production and for real payments.
# PUBLIC_URL=https://example.uz
# At least 24 characters. Opens /admin.   openssl rand -hex 24
# ADMIN_KEY=
# Behind your own reverse proxy
# TRUST_PROXY=1
# Days after a visit until guest names and messages are removed
# RETENTION_DAYS=365

# --- docker compose only (letters and digits) ---------------------------------
# SITE_DOMAIN=example.uz
# DB_OWNER_PASSWORD=
# DB_APP_PASSWORD=

# --- Payments ---------------------------------------------------------------
# Octo: Visa, Mastercard, Uzcard, Humo. OCTO_TEST=1 uses Octo's test mode.
# OCTO_SHOP_ID=
# OCTO_SECRET=
# OCTO_TEST=1
# Payme Merchant API. Register https://your-domain/pay/payme in its cabinet, account field: order_id
# PAYME_MERCHANT_ID=
# PAYME_KEY=
# PAYME_TEST=1
# PAYME_CHECK_IP=1
# Fiscal receipt data, if your contract needs it: all three or none
# FISCAL_INN=
# FISCAL_SPIC=
# FISCAL_PACKAGE=
# FISCAL_VAT=0
# Test payments are on only without real ones and outside production. 1 forces them on.
# ALLOW_TEST_PAYMENTS=1

# --- AI ---------------------------------------------------------------------
# Real AI text and translation. Without it the app runs in rule-based demo mode.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Force demo mode even with a key, e.g. when the venue has no internet
# MEZBON_OFFLINE=1

# --- Other ------------------------------------------------------------------
# Let phones on the same Wi-Fi connect (plain HTTP: demo only)
# HOST=0.0.0.0
# PORT=4321
# Approximate USD price: UZS per 1 USD
# USD_RATE=
# Telegram bot for providers; runs inside the server
# TELEGRAM_BOT_TOKEN=
# Contact for push services, e.g. mailto:you@example.com
# PUSH_CONTACT=
# 0 = start with an empty database instead of sample data
# SEED=0
# For the MCP server, if the site is not on localhost:4321
# MEZBON_URL=
