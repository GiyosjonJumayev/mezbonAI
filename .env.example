# Copy to .env (never committed). Everything is optional.

# Real AI text and translation. Without it the app runs in rule-based demo mode.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Force demo mode even with a key, e.g. when the venue has no internet
# MEZBON_OFFLINE=1

# Let phones on the same Wi-Fi connect (plain HTTP: demo only)
# HOST=0.0.0.0
# PORT=4321

# Show an approximate USD price: UZS per 1 USD
# USD_RATE=

# Host bot, run with: npm run telegram
# TELEGRAM_BOT_TOKEN=
# MEZBON_URL=http://localhost:4321

# 0 = start with an empty database instead of sample data
# SEED=0
# With NODE_ENV=production test payments are off unless this is 1
# ALLOW_TEST_PAYMENTS=1

# Behind a reverse proxy (HTTPS)
# TRUST_PROXY=1
# Contact for push services, e.g. mailto:you@example.com
# PUSH_CONTACT=
